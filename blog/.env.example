# Config base
PAYLOAD_SECRET=your-local-payload-secret-here
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GA4 (ADR 0030). Vacío en dev/local: sin este valor, analytics y el
# banner de cookies no se renderizan. Measurement ID de la propiedad
# GA4 (G-XXXXXXXXXX) — ver docs/runbooks/analytics-search-console.md.
NEXT_PUBLIC_GA_ID=

# Dev A: PC con Docker solo para PostgreSQL.
# Comando: docker compose up -d postgres
COMPOSE_PROJECT_NAME=jt_blog_dev
DATABASE_URL=postgresql://blog_dev:blog_dev@localhost:5432/blog_dev
POSTGRES_DB=blog_dev
POSTGRES_USER=blog_dev
POSTGRES_PASSWORD=blog_dev
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432

# Dev B: PC sin Docker.
# Abre un túnel SSH al VPS y cambia DATABASE_URL al puerto local del túnel:
# ssh -N -L 5433:127.0.0.1:5433 usuario@tu-vps
# DATABASE_URL=postgresql://blog_dev:change_me_dev@localhost:5433/blog_dev

# Producción: VPS con Docker Compose app + PostgreSQL.
# Copia este archivo como .env en el VPS y cambia secretos/host según corresponda:
# COMPOSE_PROJECT_NAME=jt_blog_prod
# COMPOSE_PROFILES=prod
# APP_IMAGE=ghcr.io/tu-usuario/josetejero-blog:latest
# DATABASE_URL=postgresql://blog_prod:change_me_prod_db_password@postgres:5432/blog_prod
# POSTGRES_DB=blog_prod
# POSTGRES_USER=blog_prod
# POSTGRES_PASSWORD=change_me_prod_db_password
# PAYLOAD_SECRET=change_me_long_random_payload_secret
# NEXT_PUBLIC_SITE_URL=https://josetejero.com
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# APP_BIND=127.0.0.1
# APP_PORT=3000
# Token del endpoint POST /api/revalidate (warm-up del pipeline, ADR 0031).
# Debe coincidir con el secret REVALIDATE_SECRET del repo en GitHub Actions.
# Generar con: openssl rand -hex 32
# REVALIDATE_SECRET=change_me_openssl_rand_hex_32
